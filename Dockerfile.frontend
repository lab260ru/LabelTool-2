# LabelTool 2 — frontend production build (docker compose: frontend service).
# Stage 1: node 22 — tsc + vite build. All /api requests go to the real backend
# via the nginx proxy (same-origin).
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts index.html ./
COPY public ./public
COPY src ./src

RUN npm run build

# Stage 2: nginx — static dist + proxy /api → backend:8000 (cookie sessions
# work as same-origin; body limit 220m for audio ≤200 MB).
FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
