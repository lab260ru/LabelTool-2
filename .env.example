# ============================================================================
# LabelTool 2 — environment configuration (docker compose).
# Copy to .env and fill in your own values:  cp .env.example .env
# The .env file is not committed (see .gitignore). ALWAYS change passwords and SECRET_KEY.
# ============================================================================

# --- Initial super-administrator ---------------------------------------------
# Created on first start (if it does not exist yet). The only account in a fresh
# DB; other users are created by an admin or sign up themselves.
SUPERUSER_LOGIN=admin
SUPERUSER_PASSWORD=change-me-please
SUPERUSER_FIO=Administrator

# Demo data (projects/annotators/showcases). true — populate the DB with samples
# (handy to try the app out), false — start empty (production).
SEED_DEMO=false

# --- Session signing ---------------------------------------------------------
# Any long random string. For example: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=labeltool2
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=labeltool2

# --- MinIO / S3 (audio storage) ----------------------------------------------
MINIO_ROOT_USER=labeltool2
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_BUCKET=labeltool2
# Public S3 address for presigned links in the browser (MinIO's exposed port).
# When deploying, replace with the real external address (e.g. https://s3.example.com).
S3_PUBLIC_ENDPOINT=http://localhost:9000
